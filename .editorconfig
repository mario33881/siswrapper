# EditorConfig documentation: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf

# 4 space indentation
[*.{yml,py,cfg,blif,eqn}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,gitignore}]
trim_trailing_whitespace = true
insert_final_newline = true
